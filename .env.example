# ========================================
#  本地开发环境变量
#  复制为 .env 后使用 (start-local.bat 自动加载)
# ========================================

# Cloudflare API 凭据（语义搜索 embedding 需要）
CF_ACCOUNT_ID=your-account-id
CF_API_TOKEN=your-api-token

# SE 服务器（CF Function 直接 TCP 和 verify/sync 使用，客户端不再需要）
SE_HOST=127.0.0.1
SE_PORT=10086
SE_AUTH_KEY=12345
SE_BLACKLIST=76561199251433037

# 管理密钥（bridge-server 调用 CF admin 端点时使用，需与 CF Dashboard 一致）
SE_ADMIN_KEY=change-me

# 服务端桥接地址（客户端 EXE/APK 全部经此转发）
BRIDGE_URL=http://183.131.51.12:10085
